[user]
	name = Florian Heeg
	email = florian.heeg@accenture.com
[include]
	path = ~/.config/git/audi/maintenance.gitconfig
[color]
	ui = auto
[init]
	defaultBranch = main
	templateDir = ~/.config/git-templates/git-secrets
[push]
	autoSetupRemote = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	syntax-theme = github-dark-dimmed
	line-numbers = true
	hyperlinks = true
[merge]
	conflictStyle = zdiff3
[secrets]
	providers = git secrets --aws-provider
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
# Personal identity + GitHub credentials — must come after the [credential]
# blocks above so its `helper =` resets take effect last (git accumulates
# credential.helper entries in file order; a later empty reset clears
# everything defined earlier for the same URL).
[includeIf "gitdir:~/EDF/Privat/"]
	path = ~/.config/git/personal
[includeIf "gitdir:~/.local/share/chezmoi/"]
	path = ~/.config/git/personal

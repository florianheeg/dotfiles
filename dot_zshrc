# General
export COLORTERM=truecolor
export EDITOR="nano"
setopt AUTO_CD
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
HISTSIZE=50000
SAVEHIST=50000

# Homebrew
export HOMEBREW_AUTO_UPDATE_SECS="86400"

# Refresh the brew-outdated-count cache (read by starship) on shell start,
# then every $PERIOD seconds while an interactive shell stays open — no
# launchd/system daemon needed.
PERIOD=21600 # 6 hours
periodic() {
  [ -x "$HOME/.local/bin/brew-check" ] && "$HOME/.local/bin/brew-check" &!
}
periodic

# Auto-select the personal GitHub account for git + gh CLI when inside a
# personal-identity directory. Reads git's already-resolved user.email
# (driven by .gitconfig's includeIf) rather than checking $PWD directly,
# so it stays correct even inside a worktree checked out elsewhere.
# GH_TOKEN is exported per-shell only — never touches the shared global
# gh active-account state, so concurrent terminals on other topics are
# unaffected.
autoload -Uz add-zsh-hook
_gh_token_for_dir() {
  if git rev-parse --git-dir >/dev/null 2>&1 \
    && [ "$(git config --get user.email 2>/dev/null)" = "florian.heeg@gmail.com" ]; then
    export GH_TOKEN="$(gh auth token --user florianheeg 2>/dev/null)"
  else
    unset GH_TOKEN
  fi
}
add-zsh-hook chpwd _gh_token_for_dir
_gh_token_for_dir

# Zinit
source "${HOMEBREW_PREFIX}/opt/zinit/zinit.zsh"
zinit light zsh-users/zsh-completions
autoload -Uz compinit
compinit
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-autosuggestions

# Starship
eval "$(starship init zsh)"

# fnm
eval "$(fnm env --use-on-cd --shell zsh)"
eval "$(fnm completions --shell zsh)"

# skills.sh
export DISABLE_TELEMETRY=1

# Named directories
source "$HOME/.config/zsh/named-dirs.zsh"

# aliases
source "$HOME/.config/zsh/aliases.zsh"

# Audi-specific setup — see ~/.config/zsh/audi/README.md for offboarding steps
[ -f "$HOME/.config/zsh/audi/bedrock.zsh" ] && source "$HOME/.config/zsh/audi/bedrock.zsh"

# Mise
eval "$(mise activate zsh)"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

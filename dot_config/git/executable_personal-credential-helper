#!/bin/sh
# Git credential helper for the "florianheeg" personal GitHub account.
# Uses `gh auth token --user florianheeg`, which returns that account's
# token regardless of which gh account is currently "active" — no
# `gh auth switch` needed before pushing to personal repos.

GH_USER="florianheeg"

case "$1" in
  get)
    token="$(gh auth token --user "$GH_USER" 2>/dev/null)"
    if [ -n "$token" ]; then
      printf 'username=%s\n' "$GH_USER"
      printf 'password=%s\n' "$token"
    fi
    ;;
  store|erase)
    # gh manages token storage itself; nothing to do.
    ;;
esac

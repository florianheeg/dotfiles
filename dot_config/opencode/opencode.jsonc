{
  "$schema": "https://opencode.ai/config.json",

  "update": "disable",

  "shell": "/bin/zsh",
  "model": "anthropic/default",
  "default_agent": "plan",

  "plugins": ["opencode-claude-auth-v2@latest"],

  "providers": {
    "anthropic": {
      "models": {
        "smol": {
          "modelID": "claude-haiku-4-5",
          "name": "Smol (Haiku, high effort)",
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 200000, "output": 64000 },
          "cost": { "input": 1, "output": 5, "cache": { "read": 0.1, "write": 1.25 } },
          "settings": { "thinking": { "type": "enabled", "budgetTokens": 16000 } }
        },
        "default": {
          "modelID": "claude-sonnet-5",
          "name": "Default (Sonnet, medium effort)",
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 },
          "cost": { "input": 2, "output": 10, "cache": { "read": 0.2, "write": 2.5 } },
          "settings": { "thinking": { "type": "adaptive", "display": "summarized" }, "effort": "medium" }
        },
        "slow": {
          "modelID": "claude-opus-5",
          "name": "Slow (Opus, medium effort)",
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 },
          "cost": { "input": 5, "output": 25, "cache": { "read": 0.5, "write": 6.25 } },
          "settings": { "thinking": { "type": "adaptive", "display": "summarized" }, "effort": "medium" }
        }
      }
    }
  },

  "agents": {
    "title": { "model": "anthropic/smol" },
    "explore": { "model": "anthropic/smol" },
    "general": { "model": "anthropic/default" },
    "summary": { "model": "anthropic/smol" }
  },

  "mcp": {
    "servers": {
      "bork": {
        "type": "local",
        "command": ["pnx", "@asg-song/bork-cli", "mcp"]
      }
    }
  },

  // Based on: https://bork/tooling/git-guardrails-for-agents.md
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },

    // Ask for any Git command not explicitly allowed below.
    { "action": "shell", "resource": "git *", "effect": "ask" },
    
    // Safe git operations: auto-approve read-only operations
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git tag *", "effect": "allow" },
    
    // Common write operations: auto-approve
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git pull *", "effect": "allow" },
    
    // Non-destructive checkout operations
    { "action": "shell", "resource": "git checkout -b *", "effect": "allow" },

    // Only a normal push uses the configured upstream; force and
    // remote-deletion variants remain subject to the Git catch-all above.
    { "action": "shell", "resource": "git push", "effect": "allow" },
    
    // Merge operations
    { "action": "shell", "resource": "git merge *", "effect": "allow" }
  ]
}

{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["opencode-claude-auth@latest"],
  "mcp": {
    "servers": {
      "bork": {
        "type": "local",
        "command": ["pnx", "@asg-song/bork-cli", "mcp"]
      }
    }
  },
  // Permissions: control agent actions
  // Based on: https://bork/tooling/git-guardrails-for-agents.md
  // Reference: https://opencode.ai/v2/docs/permissions/
  "permissions": [
    // Catch-all: ask before running shell commands
    { "action": "shell", "resource": "*", "effect": "ask" },
    
    // Safe git operations: auto-approve read-only operations
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git tag *", "effect": "allow" },
    
    // Common write operations: auto-approve
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git pull *", "effect": "allow" },
    
    // Non-destructive checkout operations
    { "action": "shell", "resource": "git checkout -b *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout -B *", "effect": "allow" },
    
    // Merge operations
    { "action": "shell", "resource": "git merge *", "effect": "allow" },
    
    // Destructive operations per git-guardrails-for-agents.md — ask for approval
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean -f *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop *", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear *", "effect": "ask" },
    
    // Force-push variants: ask for approval (allows human judgment per git-guardrails)
    { "action": "shell", "resource": "git push --force *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force-with-lease *", "effect": "ask" },
    { "action": "shell", "resource": "git push -f *", "effect": "ask" },
    { "action": "shell", "resource": "git push * +* *", "effect": "ask" },
    
    // Remote deletions: ask for approval
    { "action": "shell", "resource": "git push *--delete *", "effect": "ask" },
    
    // History rewrites: ask for approval
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git filter-repo *", "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "ask" },
    { "action": "shell", "resource": "git reflog expire *", "effect": "ask" },
    { "action": "shell", "resource": "git gc *--prune=now *", "effect": "ask" },
    
    // Worktree cleanup: ask for approval
    { "action": "shell", "resource": "git worktree remove *--force *", "effect": "ask" }
  ]
}

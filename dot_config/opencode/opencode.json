{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-5.6-luna",
  "plugin": ["opencode-claude-auth@latest"],
  "small_model": "github-copilot/gpt-5.4-mini",
  "default_agent": "plan",
  "autoupdate": false,
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "eu-central-1",
        "profile": "844592952383_developer_eu-central-1"
      }
    }
  },
  "agent": {
    "plan": {
      "color": "error",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "router": "allow",
          "research": "allow",
          "deep-research": "allow",
          "reviewer": "allow",
          "architect": "allow"
        }
      }
    },
    "build": {
      "color": "primary",
      "permission": {
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow",
          "router": "allow",
          "research": "allow",
          "deep-research": "allow",
          "reviewer": "allow",
          "architect": "allow",
          "implementer-pro": "allow"
        }
      }
    }
  },
  "share": "manual",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", "coverage/**"]
  },
  "permission": {
    "bash": {
      "git push *": "ask"
    },
    "skill": {
      "brainstorming": "ask"
    }
  },
  "mcp": {
    "mcp-atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "enabled": true,
      "environment": {
        "JIRA_URL": "https://collaboration.msi.audi.com/jira",
        "JIRA_PERSONAL_TOKEN": "{env:AUDI_JIRA_PERSONAL_TOKEN}"
      }
    },
    "bork": {
      "type": "local",
      "command": ["bork", "mcp"],
      "enabled": true
    }
  }
}

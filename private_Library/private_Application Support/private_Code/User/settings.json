{
  "extensions.autoUpdate": "off",
  "editor.fontFamily": "Fira Code, Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 12,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.wordWrap": "off",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/node_modules": true,
  },
  "search.exclude": {
    "**/node_modules": true,
    "dist/": true,
    "coverage/": true,
  },
  "terminal.external.osxExec": "kitty.app",
  "terminal.integrated.fontFamily": "FiraCode Nerd Font Mono, Menlo, Monaco, 'Courier New', monospace",
  "terminal.integrated.fontLigatures.enabled": false,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "workbench.sideBar.location": "right",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "GitHub Dark Dimmed",
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://docs.renovatebot.com": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://models.dev/model-schema.json": true,
    "https://opencode.ai/config.json": true,
    "https://opencode.ai/theme.json": true,
    "https://opencode.ai/tui.json": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  },
  "redhat.telemetry.enabled": false,
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
  },
  "[markdown]": {
    "editor.wordWrap": "on",
  },
  "window.zoomLevel": 1.1,
  "projectManager.git.baseFolders": ["~/EDF/Audi/Arcade"],
  "projectManager.confirmSwitchOnActiveWindow": "always",
  "projectManager.tags": ["Personal", "Work", "Audi"],
  "projectManager.sortList": "Name",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "[typescript]": {},
  "js/ts.tsserver.log": "off",
  "diffEditor.ignoreTrimWhitespace": false,
}
